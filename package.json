{
  "name": "jo.alloussi.stockwell",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:offline-sync": "jest __tests__/integration/offline-sync.suite.test.ts --verbose",
    "contrast": "jest __tests__/unit/contrast.test.ts",
    "deps:cruise": "depcruise --config .dependency-cruiser.js src",
    "api:types": "openapi-typescript openapi/stockwell.openapi.yaml -o src/types/api.generated.ts",
    "assets": "react-native-asset",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.5.7",
    "@op-engineering/op-sqlite": "^17.1.3",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/new-app-screen": "0.86.2",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@sentry/react-native": "^8.21.0",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "drizzle-orm": "^0.45.2",
    "react": "19.2.3",
    "react-hook-form": "^7.83.0",
    "react-native": "0.86.2",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.3",
    "react-native-permissions": "^5.6.1",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "^15.15.5",
    "react-native-vision-camera": "4.6.4",
    "react-native-worklets": "^0.11.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^11.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "dependency-cruiser": "16.10.2",
    "eslint": "^8.19.0",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^17.2.0",
    "msw": "^1.3.5",
    "openapi-typescript": "^7.13.0",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-native-asset": "^2.3.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
