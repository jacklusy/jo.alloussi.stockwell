# Fastlane — Android release scaffolding (M-16)
# Fill credentials via GitHub Secrets / local env — never commit keystores.

default_platform(:android)

platform :android do
  desc "Build a signed release AAB"
  lane :release_aab do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android",
      properties: {
        "android.injected.signing.store.file" => ENV["STOCKWELL_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["STOCKWELL_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["STOCKWELL_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["STOCKWELL_KEY_PASSWORD"],
        "versionCode" => ENV["VERSION_CODE"] || "1",
        "versionName" => ENV["VERSION_NAME"] || "0.1.0",
      }
    )
  end

  desc "Upload AAB to Play closed testing track"
  lane :closed_track do
    upload_to_play_store(
      track: "closed",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: ENV["PLAY_JSON_KEY_PATH"]
    )
  end
end
